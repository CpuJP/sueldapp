import { ScrollView } from "std-widgets.slint";
import { Tema, Disp } from "../tema.slint";
import { Cifra, FilaTabla } from "../estado.slint";
import { Vidrio, Etiqueta, Ayuda, Separador, EstadoChip } from "../componentes.slint";

// Pantalla: barra de título fija con acciones (@children de la barra) y contenido desplazable.
export component Encabezado inherits Vidrio {
    in property <string> titulo;
    min-height: 64px;
    vertical-stretch: 0;
    VerticalLayout {
        padding-left: Disp.pequeno ? 14px : 22px;
        padding-right: 14px;
        padding-top: Disp.pequeno ? 10px : 0px;
        if Disp.pequeno: Text {
            text: root.titulo;
            color: Tema.texto;
            font-size: 20px;
            font-weight: 700;
            accessible-role: text;
        }
        HorizontalLayout {
            spacing: 10px;
            if !Disp.pequeno: Text {
                text: root.titulo;
                color: Tema.texto;
                font-size: 22px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
                accessible-role: text;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: Disp.pequeno ? start : end;
                padding-top: Disp.pequeno ? 8px : 13px;
                padding-bottom: Disp.pequeno ? 10px : 13px;
                @children
            }
        }
    }
}

export component Desplazable inherits ScrollView {
    in property <length> separacion: Disp.separacion;
    content-width: self.visible-width;
    content-height: contenido.preferred-height + 24px;
    contenido := VerticalLayout {
        width: root.visible-width - 2px;
        spacing: root.separacion;
        padding-bottom: 24px;
        @children
    }
}

export component Panel inherits Vidrio {
    in property <length> relleno: Disp.pequeno ? 14px : 22px;
    VerticalLayout {
        padding: root.relleno;
        spacing: 10px;
        alignment: start;
        @children
    }
}

export component Cifras inherits GridLayout {
    in property <[Cifra]> cifras;
    in property <int> columnas: 2;
    // Ancho disponible: limita las columnas para que las cifras no se corten.
    in property <length> ancho-disp: Disp.contenido;
    property <int> cols: max(1, min(root.columnas, floor(root.ancho-disp / 190px)));
    spacing: 0px;
    for c[i] in cifras: Rectangle {
        col: mod(i, root.cols);
        row: floor(i / root.cols);
        // El alto sale del contenido: con una columna, las notas largas ocupan varias líneas.
        height: max(72px, celda.preferred-height);
        Rectangle {
            x: 0;
            width: 1px;
            height: parent.height;
            background: Tema.borde-suave;
            visible: mod(i, root.cols) != 0;
        }
        Rectangle {
            y: 0;
            width: parent.width;
            height: 1px;
            background: Tema.borde-suave;
            visible: i >= root.cols;
        }
        celda := VerticalLayout {
            padding-left: 16px;
            padding-right: 12px;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 2px;
            accessible-role: text;
            accessible-label: c.etiqueta + ": " + c.valor + " " + c.nota;
            Text {
                text: c.etiqueta;
                color: Tema.texto-3;
                font-size: 13px;
                font-weight: 600;
            }
            Text {
                text: c.valor;
                color: c.negativo ? Tema.negativo : Tema.texto;
                font-size: 21px;
                font-weight: 650;
                overflow: elide;
            }
            if c.nota != "": Ayuda {
                text: c.nota;
            }
        }
    }
}

// Tarjeta principal: cifra grande a la izquierda, cuadrícula de cifras a la derecha.
export component Heroe inherits Vidrio {
    in property <string> etiqueta;
    in property <string> valor;
    in property <bool> negativo;
    in property <string> nota;
    in property <[Cifra]> cifras;
    in property <length> ancho-disp: Disp.contenido;
    property <bool> apilar: root.ancho-disp < 720px;
    property <length> relleno: Disp.pequeno ? 14px : 22px;
    GridLayout {
        padding: root.relleno;
        spacing: root.apilar ? 14px : 28px;
        VerticalLayout {
            col: 0;
            row: 0;
            width: root.apilar ? root.width - root.relleno * 2 : root.width * 40%;
            alignment: center;
            spacing: 6px;
            Etiqueta {
                text: root.etiqueta;
            }
            Text {
                text: root.valor;
                color: root.negativo ? Tema.negativo : Tema.texto;
                font-size: root.apilar ? 34px : 44px;
                font-weight: 700;
                letter-spacing: -0.9px;
                wrap: word-wrap;
                accessible-role: text;
                accessible-label: root.etiqueta + ": " + root.valor;
            }
            Ayuda {
                text: root.nota;
            }
            @children
        }
        VerticalLayout {
            col: root.apilar ? 0 : 1;
            row: root.apilar ? 1 : 0;
            alignment: center;
            Cifras {
                ancho-disp: root.apilar ? root.ancho-disp - root.relleno * 2 : root.ancho-disp * 55%;
                cifras: root.cifras;
            }
        }
    }
}

// Tabla simple de texto (columnas iguales; la primera alineada a la izquierda).
export component TablaTexto inherits VerticalLayout {
    in property <[string]> encabezados;
    in property <[FilaTabla]> filas;
    callback fila-activada(int);
    in property <bool> activable;
    // La segunda columna muestra el distintivo de `estado` en vez de su texto.
    in property <bool> con-estado;
    // Con muchas columnas en poco espacio, la tabla se desplaza de lado en vez de apretarse.
    property <length> ancho: max(root.width, (root.encabezados.length + 1) * 118px);
    property <length> columna: (root.ancho - 16px - 8px * (root.encabezados.length - 1)) / (root.encabezados.length + 1);
    Flickable {
        height: tabla.preferred-height;
        content-width: root.ancho;
        content-height: self.height;
        tabla := VerticalLayout {
            width: root.ancho;
    HorizontalLayout {
        padding: 8px;
        spacing: 8px;
        for e[i] in root.encabezados: Etiqueta {
            text: e;
            width: root.columna * (i == 0 ? 2 : 1);
            horizontal-alignment: i == 0 ? left : right;
        }
    }
    Separador { }
    for f[j] in root.filas: Rectangle {
        min-height: 40px;
        background: ta.has-hover && root.activable ? Tema.vidrio-hundido : transparent;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 8px;
            for c[i] in f.c: Rectangle {
                width: root.columna * (i == 0 ? 2 : 1);
                if root.con-estado && i == 1 && f.estado != "": EstadoChip {
                    x: parent.width - self.width;
                    y: (parent.height - self.height) / 2;
                    width: self.preferred-width;
                    texto: f.estado;
                    tipo: f.tipo;
                }
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: c;
                    color: f.negativos.length > i && f.negativos[i] ? Tema.negativo : Tema.texto;
                    font-size: 14px;
                    vertical-alignment: center;
                    horizontal-alignment: i == 0 ? left : right;
                    overflow: elide;
                }
            }
        }
        Separador {
            y: parent.height - 1px;
            width: parent.width;
        }
        ta := TouchArea {
            enabled: root.activable;
            mouse-cursor: root.activable ? pointer : default;
            clicked => {
                root.fila-activada(j);
            }
        }
    }
        }
    }
}

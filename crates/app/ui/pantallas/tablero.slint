import { Tema } from "../tema.slint";
import { TableroD, App, Linea, ModuloV } from "../estado.slint";
import { Vidrio, Boton, Icono, Iconos, Etiqueta, Ayuda, Titulo, Progreso, Separador, Campo, Selector } from "../componentes.slint";
import { Grafico, BarrasH } from "../graficos.slint";
import { Encabezado, Desplazable, Panel, Cifras, Heroe, TablaTexto } from "comun.slint";

component Calendario inherits Rectangle {
    // La ventana emergente crea el calendario al abrirse: parte del periodo actual.
    in-out property <int> inicio: TableroD.desde;
    in-out property <int> fin: TableroD.hasta;
    in-out property <int> previa: -1;
    in-out property <int> anio-vista: floor(TableroD.hasta / 12);
    callback cerrar();
    property <int> a0: fin >= 0 ? min(inicio, fin) : (previa >= 0 ? min(inicio, previa) : inicio);
    property <int> a1: fin >= 0 ? max(inicio, fin) : (previa >= 0 ? max(inicio, previa) : inicio);
    property <[string]> cortos: ["Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"];
    property <[string]> largos: ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
    width: 500px;
    height: 420px;
    border-radius: Tema.radio-l;
    background: Tema.oscuro ? #182124 : #f6f9f9;
    border-width: 1px;
    border-color: Tema.vidrio-borde;
    drop-shadow-blur: 30px;
    drop-shadow-offset-y: 12px;
    drop-shadow-color: Tema.sombra.transparentize(0.4);
    clip: true;
    accessible-role: groupbox;
    accessible-label: "Elegir periodo";
    HorizontalLayout {
        Rectangle {
            width: 190px;
            background: Tema.vidrio-hundido;
            VerticalLayout {
                padding: 10px;
                spacing: 2px;
                alignment: start;
                for p[i] in TableroD.presets: Rectangle {
                    height: 36px;
                    border-radius: Tema.radio-s;
                    background: TableroD.preset-activo == i ? Tema.acento-suave : (tp.has-hover ? Tema.vidrio-fuerte : transparent);
                    accessible-role: button;
                    accessible-label: p.nombre;
                    accessible-action-default => {
                        TableroD.aplicar-preset(i);
                        root.cerrar();
                    }
                    Text {
                        x: 12px;
                        text: p.nombre;
                        color: TableroD.preset-activo == i ? Tema.texto : Tema.texto-2;
                        font-weight: 550;
                        font-size: 14px;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                    tp := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            TableroD.aplicar-preset(i);
                            root.cerrar();
                        }
                    }
                }
            }
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Tema.borde-suave;
            }
        }
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            HorizontalLayout {
                Boton {
                    solo-icono: true;
                    icono: Iconos.anterior;
                    etiqueta-accesible: "Año anterior";
                    clicked => {
                        root.anio-vista -= 1;
                    }
                }
                Text {
                    text: root.anio-vista;
                    color: Tema.texto;
                    font-size: 17px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Boton {
                    solo-icono: true;
                    icono: Iconos.siguiente;
                    etiqueta-accesible: "Año siguiente";
                    clicked => {
                        root.anio-vista += 1;
                    }
                }
            }
            GridLayout {
                spacing-vertical: 6px;
                for n[i] in root.cortos: Rectangle {
                    property <int> k: root.anio-vista * 12 + i;
                    property <bool> extremo: k == root.inicio || (root.fin >= 0 && k == root.fin);
                    property <bool> dentro: k > root.a0 && k < root.a1;
                    property <bool> sin-datos: k < TableroD.datos-desde || k > TableroD.datos-hasta;
                    col: mod(i, 3);
                    row: floor(i / 3);
                    height: 44px;
                    background: extremo ? Tema.acento : (dentro ? Tema.acento-suave : (tm.has-hover ? Tema.vidrio-hundido : transparent));
                    border-top-left-radius: (extremo && k == root.a0) || mod(i, 3) == 0 ? 22px : 0px;
                    border-bottom-left-radius: (extremo && k == root.a0) || mod(i, 3) == 0 ? 22px : 0px;
                    border-top-right-radius: (extremo && k == root.a1) || mod(i, 3) == 2 ? 22px : 0px;
                    border-bottom-right-radius: (extremo && k == root.a1) || mod(i, 3) == 2 ? 22px : 0px;
                    accessible-role: button;
                    accessible-label: root.largos[i] + " " + root.anio-vista + (sin-datos ? ", sin datos" : "");
                    accessible-checked: k >= root.a0 && k <= root.a1;
                    Text {
                        text: n;
                        color: extremo ? Tema.acento-texto : (sin-datos ? Tema.texto-3 : Tema.texto);
                        font-weight: sin-datos ? 500 : 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                    if k == TableroD.hoy: Rectangle {
                        x: (parent.width - 5px) / 2;
                        y: parent.height - 9px;
                        width: 5px;
                        height: 5px;
                        border-radius: 2.5px;
                        background: extremo ? Tema.acento-texto : Tema.texto-2;
                    }
                    tm := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if root.inicio < 0 || root.fin >= 0 {
                                root.inicio = k;
                                root.fin = -1;
                            } else if k < root.inicio {
                                root.fin = root.inicio;
                                root.inicio = k;
                            } else {
                                root.fin = k;
                            }
                            root.previa = -1;
                        }
                        changed has-hover => {
                            if self.has-hover && root.inicio >= 0 && root.fin < 0 {
                                root.previa = k;
                            }
                        }
                    }
                }
            }
            Text {
                text: root.fin >= 0 ? root.cortos[mod(root.a0, 12)] + " " + floor(root.a0 / 12) + " – " + root.cortos[mod(root.a1, 12)] + " " + floor(root.a1 / 12) : "Desde " + root.cortos[mod(root.inicio, 12)] + " " + floor(root.inicio / 12) + ": elige el mes final";
                color: Tema.texto-2;
                font-weight: 600;
                font-size: 13.5px;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Boton {
                    texto: "Cancelar";
                    clicked => {
                        root.cerrar();
                    }
                }
                Boton {
                    texto: "Aplicar";
                    primario: true;
                    habilitado: root.fin >= 0;
                    clicked => {
                        TableroD.aplicar-rango(root.a0, root.a1);
                        root.cerrar();
                    }
                }
            }
        }
    }
}

component Leyenda inherits HorizontalLayout {
    in property <color> color;
    in property <string> texto;
    spacing: 7px;
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 3px;
            background: root.color;
        }
    }
    Text {
        text: root.texto;
        color: Tema.texto-2;
        font-weight: 600;
        font-size: 13.5px;
        vertical-alignment: center;
    }
}

export component ListaLineas inherits VerticalLayout {
    in property <[Linea]> lineas;
    in property <string> vacio: "Sin datos.";
    if lineas.length == 0: Ayuda {
        text: root.vacio;
    }
    for l[i] in lineas: VerticalLayout {
        if i > 0: Separador { }
        HorizontalLayout {
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 12px;
            accessible-role: text;
            accessible-label: l.titulo + " " + l.sub + " " + l.monto;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                Text {
                    text: l.titulo;
                    color: Tema.texto;
                    font-weight: 600;
                    overflow: elide;
                }
                if l.tiene-progreso: Progreso {
                    valor: l.progreso;
                }
                if l.sub != "": Ayuda {
                    text: l.sub;
                    font-size: 13px;
                }
            }
            Text {
                text: l.monto;
                color: l.negativo ? Tema.negativo : Tema.texto;
                vertical-alignment: center;
            }
        }
    }
}

component ContenidoModulo inherits VerticalLayout {
    in property <ModuloV> m;
    property <bool> tabla-abierta: false;
    property <length> alto: root.m.alto * 1px;
    if root.m.tipo == 0: Heroe {
        vertical-stretch: 1;
        etiqueta: TableroD.hero-etiqueta;
        valor: TableroD.hero-valor;
        negativo: TableroD.hero-negativo;
        nota: TableroD.hero-nota;
        cifras: TableroD.cifras;
    }
    if root.m.tipo == 1: Panel {
        vertical-stretch: 1;
        Titulo {
            text: root.m.titulo;
        }
        Cifras {
            columnas: root.m.columnas;
            cifras: TableroD.kpis;
        }
    }
    if root.m.tipo == 2: Panel {
        vertical-stretch: 1;
        HorizontalLayout {
            Titulo {
                text: root.m.titulo;
                horizontal-stretch: 1;
            }
            Boton {
                texto: "Ver meses";
                clicked => {
                    App.navegar(8);
                }
            }
        }
        Progreso {
            valor: TableroD.meses-avance;
        }
        Ayuda {
            text: TableroD.meses-avance-texto;
        }
        Cifras {
            columnas: root.m.columnas;
            cifras: TableroD.meses-cifras;
        }
    }
    if root.m.tipo == 3: Panel {
        vertical-stretch: 1;
        HorizontalLayout {
            Titulo {
                text: root.m.titulo;
                horizontal-stretch: 1;
            }
            HorizontalLayout {
                spacing: 16px;
                horizontal-stretch: 0;
                Leyenda {
                    color: Tema.serie-1;
                    texto: "Ingresos";
                }
                Leyenda {
                    color: Tema.serie-2;
                    texto: "Gastos";
                }
            }
        }
        Grafico {
            height: root.alto;
            tipo: 0;
            ejes: TableroD.ejes-ig;
            barras: TableroD.ig;
            descripcion: "Ingresos y gastos por mes. Los valores están en la tabla de datos.";
        }
    }
    if root.m.tipo == 4: Panel {
        vertical-stretch: 1;
        HorizontalLayout {
            Titulo {
                text: root.m.titulo;
                horizontal-stretch: 1;
            }
            HorizontalLayout {
                spacing: 16px;
                horizontal-stretch: 0;
                Leyenda {
                    color: Tema.serie-1;
                    texto: "Sobra";
                }
                Leyenda {
                    color: Tema.polo-neg;
                    texto: "Falta";
                }
            }
        }
        Grafico {
            height: root.alto;
            tipo: 1;
            ejes: TableroD.ejes-bal;
            barras: TableroD.bal;
            descripcion: "Lo que sobra o falta cada mes. Los valores están en la tabla de datos.";
        }
    }
    if root.m.tipo == 5: Panel {
        vertical-stretch: 1;
        HorizontalLayout {
            Titulo {
                text: root.m.titulo;
                horizontal-stretch: 1;
            }
            Ayuda {
                text: "Suma de lo que sobra y falta, mes tras mes.";
                horizontal-alignment: right;
            }
        }
        Grafico {
            height: root.alto;
            tipo: 2;
            ejes: TableroD.ejes-acu;
            barras: TableroD.acu;
            linea: TableroD.acu-linea;
            area: TableroD.acu-area;
            descripcion: "Saldo acumulado mes a mes. Los valores están en la tabla de datos.";
        }
    }
    if root.m.tipo == 6 || root.m.tipo == 7 || root.m.tipo == 8 || root.m.tipo == 9 || root.m.tipo == 12: Panel {
        vertical-stretch: 1;
        Titulo {
            text: root.m.titulo;
        }
        BarrasH {
            lista: root.m.vista == 1;
            grupos: root.m.tipo == 6 ? TableroD.destino : root.m.tipo == 7 ? TableroD.categoria : root.m.tipo == 8 ? TableroD.estado : root.m.tipo == 9 ? TableroD.conceptos : TableroD.fuentes;
        }
    }
    if root.m.tipo == 10: Panel {
        vertical-stretch: 1;
        Titulo {
            text: root.m.titulo;
        }
        ListaLineas {
            lineas: TableroD.deudas;
            vacio: "No tienes deudas pendientes.";
        }
    }
    if root.m.tipo == 11: Panel {
        vertical-stretch: 1;
        Titulo {
            text: root.m.titulo;
        }
        ListaLineas {
            lineas: TableroD.mayores;
        }
    }
    if root.m.tipo == 13: Panel {
        vertical-stretch: 1;
        Titulo {
            text: root.m.titulo;
        }
        HorizontalLayout {
            alignment: start;
            Boton {
                texto: root.tabla-abierta ? "Ocultar los datos de los gráficos" : "Ver los datos de los gráficos en tabla";
                icono: Iconos.chevron;
                clicked => {
                    root.tabla-abierta = !root.tabla-abierta;
                }
            }
        }
        if root.tabla-abierta: TablaTexto {
            con-estado: true;
            encabezados: ["Mes", "Estado", "Ingresos", "Gastos", "Pagado", "Sobra / falta", "Acumulado", "Ahorro"];
            filas: TableroD.tabla;
        }
    }
}

// Tirador de un borde: se ve como una pequeña píldora y se agarra en una zona más ancha.
component Tirador inherits Rectangle {
    in property <bool> vertical;
    in property <bool> activo: true;
    // Se guardan al mover: al soltar, `pressed` ya es falso.
    out property <length> dx;
    out property <length> dy;
    out property <bool> pressed: ta.pressed;
    callback soltado();
    accessible-role: none;
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.vertical ? 6px : 54px;
        height: root.vertical ? 54px : 6px;
        border-radius: 3px;
        background: ta.has-hover || ta.pressed ? Tema.acento : Tema.texto;
    }
    ta := TouchArea {
        enabled: root.activo;
        mouse-cursor: root.vertical ? ew-resize : ns-resize;
        moved => {
            root.dx = self.mouse-x - self.pressed-x;
            root.dy = self.mouse-y - self.pressed-y;
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.dx = 0px;
                root.dy = 0px;
            } else if e.kind == PointerEventKind.up {
                root.soltado();
                root.dx = 0px;
                root.dy = 0px;
            }
        }
    }
}

// Controles de edición encima de un módulo: quitar, editar, arrastrar y cambiar de tamaño.
component EdicionModulo inherits Rectangle {
    in property <ModuloV> m;
    in property <length> doceavo;
    in property <length> separacion;
    // Punto del arrastre dentro de este módulo.
    property <length> px: TableroD.arr-x - self.absolute-position.x;
    property <length> py: TableroD.arr-y - self.absolute-position.y;
    property <bool> origen: TableroD.arr-tipo == root.m.tipo;
    property <bool> encima: TableroD.arr-tipo >= 0 && !origen && px >= 0 && px < self.width && py >= 0 && py < self.height;
    property <bool> antes: root.m.ancho == 12 ? py < self.height / 2 : px < self.width / 2;
    property <int> ancho-pedido: pedir-ancho(root.m.ancho + round(asa-lado.dx / root.doceavo));
    property <int> tam-pedido: min(2, max(0, root.m.tam + round(asa-pie.dy / 60px)));
    pure function pedir-ancho(a: int) -> int {
        return a <= 5 ? 4 : a <= 7 ? 6 : a <= 10 ? 8 : 12;
    }
    pure function texto-ancho(a: int) -> string {
        return a == 4 ? "1/3" : a == 6 ? "1/2" : a == 8 ? "2/3" : "Completo";
    }
    changed encima => {
        if encima {
            TableroD.arr-destino = root.m.tipo;
            TableroD.arr-antes = antes;
        } else if TableroD.arr-destino == root.m.tipo {
            TableroD.arr-destino = -1;
        }
    }
    changed antes => {
        if encima {
            TableroD.arr-antes = antes;
        }
    }
    border-radius: Tema.radio-l;
    border-width: 2px;
    border-color: encima ? Tema.acento : Tema.vidrio-borde;
    background: origen ? Tema.fondo.transparentize(0.25) : transparent;
    arrastre := TouchArea {
        mouse-cursor: root.origen ? grabbing : grab;
        moved => {
            if self.pressed {
                if !root.origen && abs(self.mouse-x - self.pressed-x) + abs(self.mouse-y - self.pressed-y) > 6px {
                    TableroD.arr-titulo = root.m.titulo;
                    TableroD.arr-destino = -1;
                    TableroD.arr-tipo = root.m.tipo;
                }
                TableroD.arr-x = self.absolute-position.x + self.mouse-x;
                TableroD.arr-y = self.absolute-position.y + self.mouse-y;
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.up && root.origen {
                TableroD.arr-tipo = -1;
                if TableroD.arr-destino >= 0 {
                    TableroD.mover-a(root.m.tipo, TableroD.arr-destino, TableroD.arr-antes);
                }
                TableroD.arr-destino = -1;
            }
        }
    }
    // Dónde caerá el módulo.
    if root.encima: Rectangle {
        x: root.m.ancho == 12 ? 0px : (root.antes ? -4px : root.width - 4px);
        y: root.m.ancho == 12 ? (root.antes ? -4px : root.height - 4px) : 0px;
        width: root.m.ancho == 12 ? root.width : 8px;
        height: root.m.ancho == 12 ? 8px : root.height;
        border-radius: 4px;
        background: Tema.acento;
    }
    // Vista previa del tamaño mientras se arrastra un borde.
    if asa-lado.pressed: Rectangle {
        x: 0;
        y: 0;
        width: root.doceavo * root.ancho-pedido - root.separacion;
        height: root.height;
        border-radius: Tema.radio-l;
        border-width: 3px;
        border-color: Tema.acento;
        background: Tema.acento-suave;
        Text {
            text: texto-ancho(root.ancho-pedido);
            color: Tema.texto;
            font-size: 22px;
            font-weight: 700;
        }
    }
    if asa-pie.pressed: Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 16px;
        width: 150px;
        height: 36px;
        border-radius: 18px;
        background: Tema.acento;
        Text {
            text: root.m.tams.length > tam-pedido ? root.m.tams[tam-pedido] : "";
            color: Tema.acento-texto;
            font-weight: 700;
        }
    }
    if !root.origen: Boton {
        width: self.preferred-width;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        texto: "Editar";
        icono: Iconos.lapiz;
        etiqueta-accesible: "Editar " + root.m.titulo;
        clicked => {
            TableroD.abrir-editor(root.m.tipo);
        }
    }
    asa-lado := Tirador {
        // La barra de desplazamiento ocupa el borde derecho y se quedaría con el puntero.
        x: root.width - self.width - 16px;
        y: (root.height - self.height) / 2;
        width: 24px;
        height: min(root.height, 90px);
        vertical: true;
        soltado => {
            if root.ancho-pedido != root.m.ancho {
                TableroD.cambiar-ancho(root.m.tipo, root.ancho-pedido == 4 ? 0 : root.ancho-pedido == 6 ? 1 : root.ancho-pedido == 8 ? 2 : 3);
            }
        }
    }
    asa-pie := Tirador {
        visible: root.m.con-tam;
        activo: root.m.con-tam;
        x: (root.width - self.width) / 2;
        y: root.height - self.height;
        width: 110px;
        height: 24px;
        soltado => {
            if root.m.con-tam && root.tam-pedido != root.m.tam {
                TableroD.cambiar-tam(root.m.tipo, root.tam-pedido);
            }
        }
    }
    Boton {
        x: 0px;
        y: -12px;
        width: 30px;
        height: 30px;
        solo-icono: true;
        primario: true;
        icono: Iconos.menos;
        etiqueta-accesible: "Quitar " + root.m.titulo + " del tablero";
        clicked => {
            TableroD.ocultar(root.m.tipo, false);
        }
    }
}

component ModuloTablero inherits Rectangle {
    in property <ModuloV> m;
    in property <length> doceavo;
    in property <length> separacion;
    ContenidoModulo {
        m: root.m;
    }
    if TableroD.editando: EdicionModulo {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        m: root.m;
        doceavo: root.doceavo;
        separacion: root.separacion;
    }
}

export component PantallaTablero inherits VerticalLayout {
    property <length> espacio: TableroD.espaciado == 0 ? 10px : TableroD.espaciado == 2 ? 28px : 18px;
    property <length> doceavo: (root.width - 2px + root.espacio) / 12;
    spacing: 18px;
    Encabezado {
        titulo: "Tablero";
        if TableroD.editando: Selector {
            width: 140px;
            height: 38px;
            etiqueta: "Espacio entre módulos";
            opciones: ["Compacto", "Normal", "Amplio"];
            indice: TableroD.espaciado;
            cambiado(i) => {
                TableroD.cambiar-espaciado(i);
            }
        }
        if TableroD.editando: Boton {
            texto: "Restablecer";
            clicked => {
                TableroD.restablecer();
            }
        }
        Boton {
            texto: TableroD.editando ? "Listo" : "Personalizar";
            icono: TableroD.editando ? Iconos.check : Iconos.lapiz;
            primario: TableroD.editando;
            clicked => {
                TableroD.editando = !TableroD.editando;
            }
        }
    }
    // Mientras se arrastra cerca de un borde, la pantalla se desplaza sola.
    Timer {
        interval: 16ms;
        running: TableroD.arr-tipo >= 0;
        triggered => {
            let arriba = TableroD.arr-y - desplazable.absolute-position.y;
            let tope = min(0px, desplazable.visible-height - desplazable.content-height);
            if arriba < 70px {
                desplazable.content-y = min(0px, desplazable.content-y + 10px);
            } else if arriba > desplazable.visible-height - 70px {
                desplazable.content-y = max(tope, desplazable.content-y - 10px);
            }
        }
    }
    desplazable := Desplazable {
        separacion: root.espacio;
        filtros := Vidrio {
            height: 72px;
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                spacing: 16px;
                boton-rango := Rectangle {
                    width: 290px;
                    height: 50px;
                    y: (parent.height - self.height) / 2;
                    border-radius: Tema.radio-m;
                    background: tr.has-hover ? Tema.vidrio-fuerte : Tema.vidrio-hundido;
                    border-width: fr.has-focus ? 2px : 1px;
                    border-color: fr.has-focus ? Tema.acento : Tema.vidrio-borde;
                    accessible-role: button;
                    accessible-label: "Periodo: " + TableroD.rango-nombre + ", " + TableroD.rango-texto;
                    accessible-action-default => {
                        cal-popup.show();
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Icono {
                                width: 22px;
                                height: 22px;
                                d: Iconos.calendario;
                                color: Tema.acento;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Etiqueta {
                                text: TableroD.rango-nombre;
                                font-size: 12px;
                            }
                            Text {
                                text: TableroD.rango-texto;
                                color: Tema.texto;
                                font-size: 15.5px;
                                font-weight: 700;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Icono {
                                d: Iconos.chevron;
                                color: Tema.texto-3;
                            }
                        }
                    }
                    fr := FocusScope {
                        key-pressed(e) => {
                            if e.text == " " || e.text == "\n" {
                                cal-popup.show();
                                return accept;
                            }
                            reject
                        }
                    }
                    tr := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            fr.focus();
                            cal-popup.show();
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    padding-top: 17px;
                    padding-bottom: 17px;
                    Etiqueta {
                        text: "AÑOS";
                        vertical-alignment: center;
                    }
                    for a in TableroD.anios: Boton {
                        texto: a;
                        primario: TableroD.anio-activo == a;
                        etiqueta-accesible: "Año " + a + " completo";
                        clicked => {
                            TableroD.aplicar-anio(a);
                        }
                    }
                }
            }
            cal-popup := PopupWindow {
                x: boton-rango.x;
                y: boton-rango.y + boton-rango.height + 10px;
                close-policy: close-on-click-outside;
                Calendario {
                    cerrar => {
                        cal-popup.close();
                    }
                }
            }
        }

        if TableroD.sin-meses: Panel {
            Titulo {
                text: "No hay meses en este periodo";
                horizontal-alignment: center;
            }
            Ayuda {
                text: "Elige otro periodo arriba.";
                horizontal-alignment: center;
            }
        }

        if TableroD.editando: Ayuda {
            text: "Arrastra un módulo para cambiarlo de lugar y sus bordes para cambiar el tamaño. Pulsa − para quitarlo. Se guarda solo.";
            horizontal-alignment: center;
        }
        if !TableroD.sin-meses && TableroD.filas.length == 0: Panel {
            Titulo {
                text: "Todos los módulos están ocultos";
                horizontal-alignment: center;
            }
            Ayuda {
                text: "Pulsa Personalizar para mostrar los que quieras.";
                horizontal-alignment: center;
            }
        }
        if !TableroD.sin-meses: VerticalLayout {
            spacing: root.espacio;
            for f in TableroD.filas: HorizontalLayout {
                spacing: root.espacio;
                alignment: start;
                for m in f.modulos: ModuloTablero {
                    width: root.doceavo * m.ancho - root.espacio;
                    m: m;
                    doceavo: root.doceavo;
                    separacion: root.espacio;
                }
            }
        }
    }
}

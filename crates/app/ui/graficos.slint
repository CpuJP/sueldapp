// Gráficos con geometría precalculada en Rust (fracciones 0..1). Un solo eje, rejilla tenue,
// barras con extremo redondeado anclado a la base y tooltip por mes (más grande que la marca).
import { Tema } from "tema.slint";
import { Eje, BarraMes, Grupo } from "estado.slint";
import { Ayuda } from "componentes.slint";

// tipo: 0 = barras agrupadas (a, b), 1 = barras divergentes (a con signo), 2 = línea (a).
export component Grafico inherits Rectangle {
    in property <[Eje]> ejes;
    in property <[BarraMes]> barras;
    in property <int> tipo;
    in property <string> linea;
    in property <string> area;
    in property <string> descripcion;
    property <length> izq: 66px;
    property <length> arriba: 12px;
    property <length> abajo: 34px;
    property <length> alto: self.height - arriba - abajo;
    property <length> ancho: self.width - izq - 12px;
    property <length> banda: barras.length > 0 ? ancho / barras.length : 0px;
    property <int> activo: ta.has-hover && banda > 0 ? min(barras.length - 1, floor(ta.mouse-x / banda)) : -1;
    property <length> mx: ta.mouse-x;
    property <length> my: ta.mouse-y;
    height: 260px;
    accessible-role: image;
    accessible-label: descripcion;

    for e in ejes: Rectangle {
        x: root.izq;
        y: root.arriba + root.alto * e.pos;
        width: root.ancho;
        height: 1px;
        background: Tema.rejilla;
    }
    for e in ejes: Text {
        x: 0;
        width: root.izq - 10px;
        y: root.arriba + root.alto * e.pos - 8px;
        text: e.texto;
        horizontal-alignment: right;
        font-size: 11.5px;
        font-weight: 600;
        color: Tema.texto-3;
    }
    if barras.length > 0: Rectangle {
        x: root.izq;
        y: root.arriba + root.alto * root.barras[0].base;
        width: root.ancho;
        height: 1px;
        background: Tema.base-eje;
    }

    for b[i] in barras: Rectangle {
        x: root.izq + root.banda * i;
        y: root.arriba;
        width: root.banda;
        height: root.alto;
        background: root.activo == i && root.tipo != 2 ? Tema.rejilla : transparent;
        property <length> w2: min(18px, max(2px, (root.banda - 8px) / 2));
        property <length> w1: min(28px, max(2px, root.banda - 8px));
        if root.tipo == 0: Rectangle {
            x: parent.width / 2 - w2 - 1px;
            y: parent.height * b.a;
            width: w2;
            height: max(0px, parent.height * (b.base - b.a));
            background: Tema.serie-1;
            border-top-left-radius: min(4px, self.height);
            border-top-right-radius: min(4px, self.height);
        }
        if root.tipo == 0: Rectangle {
            x: parent.width / 2 + 1px;
            y: parent.height * b.b;
            width: w2;
            height: max(0px, parent.height * (b.base - b.b));
            background: Tema.serie-2;
            border-top-left-radius: min(4px, self.height);
            border-top-right-radius: min(4px, self.height);
        }
        if root.tipo == 1 && !b.negativo: Rectangle {
            x: (parent.width - w1) / 2;
            y: parent.height * b.a;
            width: w1;
            height: max(0px, parent.height * (b.base - b.a));
            background: Tema.serie-1;
            border-top-left-radius: min(4px, self.height);
            border-top-right-radius: min(4px, self.height);
        }
        if root.tipo == 1 && b.negativo: Rectangle {
            x: (parent.width - w1) / 2;
            y: parent.height * b.base;
            width: w1;
            height: max(0px, parent.height * (b.a - b.base));
            background: Tema.polo-neg;
            border-bottom-left-radius: min(4px, self.height);
            border-bottom-right-radius: min(4px, self.height);
        }
    }

    if tipo == 2: Path {
        x: root.izq;
        y: root.arriba;
        width: root.ancho;
        height: root.alto;
        viewbox-width: 1000;
        viewbox-height: 1000;
        fit: fill;
        commands: root.area;
        fill: Tema.serie-1.transparentize(0.88);
        stroke: transparent;
    }
    if tipo == 2: Path {
        x: root.izq;
        y: root.arriba;
        width: root.ancho;
        height: root.alto;
        viewbox-width: 1000;
        viewbox-height: 1000;
        fit: fill;
        commands: root.linea;
        fill: transparent;
        stroke: Tema.serie-1;
        stroke-width: 2px;
        stroke-line-join: round;
    }
    if tipo == 2 && root.activo >= 0 && root.activo < root.barras.length: Rectangle {
        x: root.izq + root.banda * (root.activo + 0.5);
        y: root.arriba;
        width: 1px;
        height: root.alto;
        background: Tema.base-eje;
    }
    if tipo == 2 && root.activo >= 0 && root.activo < root.barras.length: Rectangle {
        x: root.izq + root.banda * (root.activo + 0.5) - 6px;
        y: root.arriba + root.alto * root.barras[root.activo].a - 6px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Tema.serie-1;
        border-width: 2px;
        border-color: Tema.vidrio-fuerte;
    }

    for b[i] in barras: Text {
        visible: b.rotulo;
        x: root.izq + root.banda * i - 20px;
        width: root.banda + 40px;
        y: root.arriba + root.alto + 10px;
        text: b.corto;
        horizontal-alignment: center;
        font-size: 11.5px;
        font-weight: 600;
        color: Tema.texto-3;
    }

    ta := TouchArea {
        x: root.izq;
        y: root.arriba;
        width: root.ancho;
        height: root.alto;
    }
    if root.activo >= 0 && root.activo < root.barras.length: tip := Rectangle {
        x: min(root.izq + root.mx + 16px, root.width - self.width - 4px);
        y: max(0px, root.arriba + root.my - self.height - 12px);
        width: t.preferred-width + 24px;
        height: t.preferred-height + 18px;
        border-radius: Tema.radio-s;
        background: Tema.vidrio-fuerte;
        border-width: 1px;
        border-color: Tema.vidrio-borde;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: Tema.sombra.transparentize(0.5);
        t := Text {
            x: 12px;
            y: 9px;
            text: root.barras[root.activo].tip;
            color: Tema.texto;
            font-size: 13.5px;
        }
    }
}

// Barras horizontales con nombre y valor directos (un color: la identidad va en el texto).
export component BarrasH inherits VerticalLayout {
    in property <[Grupo]> grupos;
    in property <color> color: Tema.serie-1;
    spacing: 12px;
    padding-top: 8px;
    if grupos.length == 0: Ayuda {
        text: "Sin datos en este periodo.";
    }
    for g in grupos: VerticalLayout {
        spacing: 5px;
        accessible-role: text;
        accessible-label: g.nombre + ": " + g.monto + " " + g.detalle;
        HorizontalLayout {
            spacing: 10px;
            Text {
                text: g.nombre;
                color: Tema.texto;
                font-weight: 600;
                font-size: 14px;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: g.monto;
                color: Tema.texto;
                font-weight: 600;
                font-size: 14px;
            }
            Text {
                text: g.detalle;
                color: Tema.texto-3;
                font-weight: 600;
                font-size: 12.5px;
                vertical-alignment: center;
            }
        }
        Rectangle {
            height: 8px;
            border-radius: 4px;
            background: Tema.rejilla;
            Rectangle {
                x: 0;
                width: parent.width * clamp(g.frac, 0, 1);
                height: parent.height;
                border-radius: 4px;
                background: root.color;
            }
        }
    }
}

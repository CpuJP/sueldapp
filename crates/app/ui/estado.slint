// Datos que la interfaz muestra y acciones que pide. Todo llega calculado y formateado desde
// Rust: la interfaz no calcula dinero.

export struct Fila {
    id: int,
    titulo: string,
    etiquetas: [string],
    monto: string,
    negativo: bool,
    estado: string,
    tipo: int, // 0 pendiente, 1 pagado, 2 no, 3 aplazado
    periodo: string,
}

export struct Pagina {
    desde: int,
    hasta: int,
    cantidad: int,
    anterior: bool,
    siguiente: bool,
}

export struct Cifra {
    etiqueta: string,
    valor: string,
    nota: string,
    negativo: bool,
}

export struct Eje {
    pos: float, // 0..1 desde arriba
    texto: string,
}

// Geometría ya normalizada (0..1 desde arriba) para dibujar un mes en los gráficos.
export struct BarraMes {
    corto: string,
    a: float,
    b: float,
    base: float,
    negativo: bool,
    rotulo: bool,
    tip: string,
}

export struct Grupo {
    nombre: string,
    monto: string,
    detalle: string,
    frac: float,
}

export struct Linea {
    titulo: string,
    sub: string,
    monto: string,
    negativo: bool,
    progreso: float,
    tiene-progreso: bool,
}

export struct FilaTabla {
    c: [string],
    negativos: [bool],
    estado: string,
    tipo: int,
}

export struct ModuloV {
    tipo: int,
    titulo: string,
    titulo-propio: string,
    ancho: int, // doceavos
    ancho-i: int,
    tam: int,
    vista: int,
    columnas: int,
    alto: float,
    con-titulo: bool,
    con-tam: bool,
    vistas: [string],
    tams: [string],
}

export struct FilaModulos {
    modulos: [ModuloV],
}

export struct FilaMes {
    clave: int,
    nombre: string,
    situacion: string,
    tipo: int,
    pagado: string,
    por-pagar: string,
    avance: float,
    atrasado: bool,
    por-confirmar: bool,
}

export struct Preset {
    nombre: string,
    desde: int,
    hasta: int,
}

export struct DeudaFila {
    id: int,
    nombre: string,
    saldada: bool,
    progreso: float,
    tiene-progreso: bool,
    progreso-texto: string,
    pagado: string,
    total: string,
    pendiente: string,
    cuotas: string,
    fin: string,
    abierta: bool,
    num: int,
    filas: [Fila],
    pagina: Pagina,
}

export struct TarjetaFila {
    id: int,
    nombre: string,
    registrados: string,
    uso: float,
    tiene-uso: bool,
    uso-texto: string,
    cupo: string,
    saldo: string,
    disponible: string,
    disponible-negativo: bool,
    corte: string,
    pago: string,
    total-pagado: string,
    abierta: bool,
    num: int,
    filas: [Fila],
    pagina: Pagina,
}

export struct ItemFila {
    id: int,
    nombre: string,
    sub: string,
}

export struct Aviso {
    id: int,
    texto: string,
    tipo: int, // 0 = éxito, 1 = advertencia, 2 = error

    deshacer: bool,
}

export struct LineaLog {
    origen: string,
    accion: string,
    detalle: string,
}

export global Util {
    pure callback formatear-monto(string) -> string;
}

export global App {
    in-out property <int> vista; // 0 tablero … 7 ajustes
    in property <bool> demo;
    in property <bool> vacia;
    in property <string> ruta-base;
    in property <[Aviso]> avisos;
    in property <[Fila]> alertas;
    in property <string> alertas-texto;
    in-out property <bool> alertas-abiertas;
    in-out property <bool> alerta-activas: true;
    in-out property <int> alerta-dias: 3;
    in-out property <bool> alerta-vencidos: true;
    in-out property <bool> alerta-emergente: true;
    in-out property <bool> alerta-boton: true;
    in-out property <int> tam-pagina; // índice: 0=10, 1=25, 2=50
    callback navegar(int);
    callback deshacer(int);
    callback cerrar-aviso(int);
    callback cambiar-tam(int);
    callback ajustes-cambiados();
    callback disposicion-cambiada();
    callback abrir-gasto(int);
    callback nuevo-gasto();
}

export global TableroD {
    in property <string> rango-nombre;
    in property <string> rango-texto;
    in property <[Preset]> presets;
    in property <int> preset-activo;
    in property <int> desde;
    in property <int> hasta;
    in property <int> datos-desde;
    in property <int> datos-hasta;
    in property <int> hoy;
    in property <[int]> anios;
    in property <int> anio-activo;
    in property <bool> sin-meses;
    in property <string> hero-etiqueta;
    in property <string> hero-valor;
    in property <bool> hero-negativo;
    in property <string> hero-nota;
    in property <[Cifra]> cifras;
    in property <[Cifra]> kpis;
    in property <[Eje]> ejes-ig;
    in property <[BarraMes]> ig;
    in property <[Eje]> ejes-bal;
    in property <[BarraMes]> bal;
    in property <[Eje]> ejes-acu;
    in property <[BarraMes]> acu;
    in property <string> acu-linea;
    in property <string> acu-area;
    in property <[Grupo]> destino;
    in property <[Grupo]> categoria;
    in property <[Grupo]> estado;
    in property <[Grupo]> conceptos;
    in property <[Grupo]> fuentes;
    in property <[Linea]> deudas;
    in property <[Linea]> mayores;
    in property <[FilaTabla]> tabla;
    in property <[FilaModulos]> filas;
    in property <[ModuloV]> ocultos;
    in property <int> espaciado;
    in-out property <bool> editando;
    // Arrastre en curso, en coordenadas de la ventana. -1: ninguno.
    in-out property <int> arr-tipo: -1;
    in-out property <string> arr-titulo;
    in-out property <length> arr-x;
    in-out property <length> arr-y;
    in-out property <int> arr-destino: -1;
    in-out property <bool> arr-antes;
    in-out property <bool> editor-abierto;
    in-out property <ModuloV> editor;
    in-out property <bool> anadir-abierto;
    callback abrir-editor(int);
    callback mover-a(int, int, bool);
    callback mover(int, bool);
    callback ocultar(int, bool);
    callback cambiar-ancho(int, int);
    callback cambiar-tam(int, int);
    callback cambiar-vista(int, int);
    callback escribir-titulo(int, string);
    callback aplicar-titulo();
    callback cambiar-espaciado(int);
    callback restablecer();
    in property <[Cifra]> meses-cifras;
    in property <float> meses-avance;
    in property <string> meses-avance-texto;
    callback aplicar-rango(int, int);
    callback aplicar-preset(int);
    callback aplicar-anio(int);
}

export global ResumenD {
    in-out property <int> modo; // 0 mes, 1 año
    in property <string> periodo;
    in property <bool> existe;
    in property <string> situacion;
    in property <int> situacion-tipo;
    in property <bool> por-confirmar;
    in property <string> hero-etiqueta;
    in property <string> hero-valor;
    in property <bool> hero-negativo;
    in property <string> hero-nota;
    in property <[Cifra]> cifras;
    in property <float> avance;
    in property <string> avance-texto;
    in property <[Fila]> proximos;
    in property <Pagina> pag-proximos;
    in property <[Linea]> ingresos;
    in property <[int]> ingresos-ids;
    in property <Pagina> pag-ingresos;
    in property <[Fila]> gastos;
    in property <Pagina> pag-gastos;
    in property <string> total;
    in property <[FilaTabla]> anio;
    callback mover(int);
    callback hoy();
    callback cambiar-modo(int);
    callback abrir-mes-de-anio(int);
    callback marcar-pagado(int);
    callback editar-ingreso(int);
    callback nuevo-ingreso();
    callback editar-mes();
    callback marcar-hecho();
    callback paginar(string, bool);
}

export global MesesD {
    in property <[Cifra]> cifras;
    in property <float> avance;
    in property <string> avance-texto;
    in property <[FilaMes]> por-confirmar;
    in property <[FilaMes]> pendientes;
    in property <[FilaMes]> hechos;
    callback abrir(int);
    callback marcar-hecho(int);
}

export global MovsD {
    in-out property <string> texto;
    in-out property <int> anio;
    in-out property <int> mes;
    in-out property <int> estado;
    in-out property <int> pago;
    in-out property <int> categoria;
    in-out property <int> deuda;

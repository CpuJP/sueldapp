    in property <[string]> o-deudas;
    in property <[string]> o-tarjetas;
    in property <string> titulo;
    in property <string> suma;
    in property <[Fila]> filas;
    in property <Pagina> pagina;
    callback filtrar();
    callback limpiar();
    callback paginar(bool);
}

export global DeudasD {
    in property <[DeudaFila]> activas;
    in property <Pagina> pag-activas;
    in property <[DeudaFila]> saldadas;
    in property <Pagina> pag-saldadas;
    in property <int> num-activas;
    in property <int> num-saldadas;
    callback nueva();
    callback editar(int);
    callback alternar(int);
    callback nueva-cuota(int);
    callback paginar-cuotas(int, bool);
    callback paginar(string, bool);
}

export global TarjetasD {
    in property <[TarjetaFila]> tarjetas;
    in property <Pagina> pagina;
    callback nueva();
    callback editar(int);
    callback alternar(int);
    callback nuevo-pago(int);
    callback paginar-pagos(int, bool);
    callback paginar(bool);
}

export global CatsD {
    in property <[ItemFila]> estados;
    in property <Pagina> pag-estados;
    in property <[ItemFila]> categorias;
    in property <Pagina> pag-categorias;
    in property <[ItemFila]> fuentes;

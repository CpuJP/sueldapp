    callback paginar(int, bool);
}

export global DatosD {
    in-out property <bool> forzar;
    in property <bool> hay-informe;
    in property <string> informe-titulo;
    in property <bool> informe-ok;
    in property <[Cifra]> informe-datos;
    in property <[FilaTabla]> diferencias;
    in property <[FilaTabla]> aceptadas;
    in property <string> log-titulo;
    in property <[LineaLog]> log;
    in property <[Linea]> historial;
    in property <Pagina> pag-historial;
    callback importar();
    callback plantilla();
    callback exportar-ods();
    callback exportar-csv();
    callback paginar(bool);
}

// Formulario modal genérico: los campos se reutilizan según el tipo.
export global Form {
    in-out property <int> tipo; // 0 cerrado, 1 gasto, 2 ingreso, 3 deuda, 4 tarjeta, 5 mes, 6 elemento de catálogo
    in-out property <string> titulo;
    in-out property <string> error;
    in-out property <bool> puede-borrar;
    in-out property <bool> es-estado;
    in-out property <string> t1;
    in-out property <string> t2;
    in-out property <string> t3;
    in-out property <string> t4;
    in-out property <string> t5;
    in-out property <int> s1;
    in-out property <int> s2;
    in-out property <int> s3;
    in-out property <int> s4;
    in-out property <int> s5;
    in-out property <bool> b1;
    in property <[string]> o1;
    in property <[string]> o2;
    in property <[string]> o3;
    in property <[string]> o4;
    in property <[string]> o5;
    callback guardar();
    callback borrar();
    callback cancelar();
}

export global Confirmar {
    in-out property <bool> visible;
    in-out property <string> titulo;
    in-out property <string> texto;
    in-out property <string> boton: "Borrar";
    callback si();
    callback no();
}

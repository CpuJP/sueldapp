import { Tema, Disp } from "tema.slint";
import { Form, Confirmar, App, ResumenD, TableroD } from "estado.slint";
import { ScrollView } from "std-widgets.slint";
import { Vidrio, Boton, Campo, Selector, Casilla, Titulo, Ayuda, Chip, Separador, Iconos } from "componentes.slint";

component Campos inherits VerticalLayout {
    in property <string> etiqueta;
    in property <string> ayuda;
    spacing: 5px;
    horizontal-stretch: 1;
    alignment: start;
    Text {
        text: root.etiqueta;
        color: Tema.texto-2;
        font-weight: 600;
        font-size: 13.5px;
    }
    @children
    if root.ayuda != "": Ayuda {
        text: root.ayuda;
        font-size: 13px;
    }
}

component Fondo-Modal inherits Rectangle {
    background: Tema.solido ? #081214a0 : #0812145a;
    TouchArea { }
}

export component Dialogo inherits Rectangle {
    width: 100%;
    height: 100%;
    Fondo-Modal {
        width: parent.width;
        height: parent.height;
    }
    escape := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                Form.cancelar();
                return accept;
            }
            reject
        }
        Vidrio {
            fuerte: true;
            width: min(560px, root.width - 24px);
            // Si no cabe en la ventana, el formulario se desplaza por dentro.
            height: min(contenido.preferred-height, root.height - 24px);
            x: (root.width - self.width) / 2;
            y: max(12px, (root.height - self.height) / 2);
            accessible-role: groupbox;
            accessible-label: Form.titulo;
            ScrollView {
                content-width: self.visible-width;
                content-height: contenido.preferred-height;
            contenido := VerticalLayout {
                width: parent.visible-width;
                padding: 24px;
                spacing: 14px;
                Titulo {
                    text: Form.titulo;
                    font-size: 19px;
                }
                if Form.error != "": Rectangle {
                    border-radius: Tema.radio-s;
                    background: Tema.negativo-suave;
                    min-height: 36px;
                    Text {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        text: Form.error;
                        color: Tema.negativo;
                        font-weight: 600;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        accessible-role: text;
                    }
                }
                // 1: gasto
                if Form.tipo == 1: VerticalLayout {
                    spacing: 12px;
                    Campos {
                        etiqueta: "Concepto";
                        primero := Campo {
                            etiqueta: "Concepto";
                            texto <=> Form.t1;
                            init => {
                                self.focus();
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 14px;
                        Campos {
                            etiqueta: "Monto (COP)";
                            ayuda: "Ejemplo: 150.000 o 150000,50";
                            Campo {
                                etiqueta: "Monto en pesos";
                                monto: true;
                                texto <=> Form.t2;
                            }
                        }
                        Campos {
                            etiqueta: "Estado";
                            Selector {
                                etiqueta: "Estado";
                                opciones: Form.o1;
                                indice <=> Form.s1;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 14px;
                        Campos {
                            etiqueta: "Mes";
                            Selector {
                                etiqueta: "Mes";
                                opciones: Form.o2;
                                indice <=> Form.s2;
                            }
                        }
                        Campos {
                            etiqueta: "Año";
                            Campo {
                                etiqueta: "Año";
                                texto <=> Form.t3;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 14px;
                        Campos {
                            etiqueta: "Categoría";
                            Selector {
                                etiqueta: "Categoría";
                                opciones: Form.o3;
                                indice <=> Form.s3;
                            }
                        }
                        Campos {
                            etiqueta: "Cuota de la deuda";
                            Selector {
                                etiqueta: "Cuota de la deuda";
                                opciones: Form.o4;
                                indice <=> Form.s4;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 14px;
                        Campos {
                            etiqueta: "Pago de la tarjeta";
                            Selector {
                                etiqueta: "Pago de la tarjeta";
                                opciones: Form.o5;
                                indice <=> Form.s5;
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                    Campos {
                        etiqueta: "Fecha de pago (día/mes/año, opcional)";
                        Campo {
                            etiqueta: "Fecha de pago, día/mes/año, opcional";
                            texto <=> Form.t5;
                        }
                    }
                    Campos {
                        etiqueta: "Nota";
                        Campo {
                            etiqueta: "Nota";
                            multilinea: true;
                            texto <=> Form.t4;
                        }
                    }
                    Casilla {
                        texto: "No contar en los totales del mes";
                        marcada <=> Form.b1;
                    }
                }
                // 2: ingreso
                if Form.tipo == 2: VerticalLayout {
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 14px;
                        Campos {
                            etiqueta: "Fuente";
                            Selector {
                                etiqueta: "Fuente";
                                opciones: Form.o1;
                                indice <=> Form.s1;
                            }
                        }
                        Campos {
                            etiqueta: "Monto (COP)";
                            Campo {
                                etiqueta: "Monto en pesos";
                                monto: true;
                                texto <=> Form.t2;
                                init => {
                                    self.focus();
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 14px;
                        Campos {
                            etiqueta: "Mes";
                            Selector {
                                etiqueta: "Mes";
                                opciones: Form.o2;
                                indice <=> Form.s2;
                            }
                        }
                        Campos {
                            etiqueta: "Año";
                            Campo {
                                etiqueta: "Año";
                                texto <=> Form.t3;
                            }
                        }
                    }
                    Campos {
                        etiqueta: "Nota";
                        Campo {
                            etiqueta: "Nota";
                            multilinea: true;
                            texto <=> Form.t4;
                        }
                    }
                }
                // 3: deuda
                if Form.tipo == 3: VerticalLayout {
                    spacing: 12px;
                    Campos {
                        etiqueta: "Nombre";
                        Campo {
                            etiqueta: "Nombre de la deuda";
                            texto <=> Form.t1;
                            init => {
                                self.focus();
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 14px;
                        Campos {
                            etiqueta: "Total de la deuda (COP)";
                            ayuda: "Déjalo vacío si no lo sabes.";
                            Campo {
                                etiqueta: "Total de la deuda";
                                monto: true;
                                texto <=> Form.t2;
                            }
                        }
                        Campos {
                            etiqueta: "Pagado sin cuota (COP)";
                            ayuda: "Pagos que no están como gasto.";
                            Campo {
                                etiqueta: "Pagado sin cuota";
                                monto: true;
                                texto <=> Form.t3;
                            }
                        }
                    }
                    Campos {
                        etiqueta: "Notas";
                        Campo {
                            etiqueta: "Notas";
                            multilinea: true;
                            texto <=> Form.t4;
                        }
                    }
                    Casilla {
                        texto: "Deuda saldada";
                        marcada <=> Form.b1;
                    }
                }
                // 4: tarjeta
                if Form.tipo == 4: VerticalLayout {
                    spacing: 12px;
                    Campos {
                        etiqueta: "Nombre";
                        Campo {
                            etiqueta: "Nombre de la tarjeta";
                            texto <=> Form.t1;
                            init => {
                                self.focus();
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 14px;
                        Campos {
                            etiqueta: "Cupo (COP)";
                            Campo {
                                etiqueta: "Cupo";
                                monto: true;
                                texto <=> Form.t2;
                            }
                        }
                        Campos {
                            etiqueta: "Saldo actual (COP)";
                            ayuda: "Lo que debes hoy en la tarjeta.";
                            Campo {
                                etiqueta: "Saldo actual";
                                monto: true;
                                texto <=> Form.t3;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 14px;
                        Campos {
                            etiqueta: "Día de corte";
                            Campo {
                                etiqueta: "Día de corte";
                                texto <=> Form.t4;
                            }
                        }
                        Campos {
                            etiqueta: "Día de pago";
                            Campo {
                                etiqueta: "Día de pago";
                                texto <=> Form.t5;
                            }
                        }
                    }
                }
                // 5: mes
                if Form.tipo == 5: Casilla {
                    texto: "Mes hecho (ya pagaste todo)";
                    marcada <=> Form.b1;
                }
                // 6: elemento de catálogo
                if Form.tipo == 6: VerticalLayout {
                    spacing: 12px;
                    Campos {
                        etiqueta: "Nombre";
                        Campo {
                            etiqueta: "Nombre";
                            texto <=> Form.t1;
                            init => {
                                self.focus();
                            }
                        }
                    }
                    if Form.es-estado: Casilla {
                        texto: "Cuenta como pagado";
                        marcada <=> Form.b1;
                    }
                    Campos {
                        etiqueta: "Si lo borras, sus movimientos pasan a";
                        ayuda: "Solo se usa al borrar.";
                        Selector {
                            etiqueta: "Reasignar al borrar";
                            opciones: Form.o1;
                            indice <=> Form.s1;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    padding-top: 6px;
                    if Form.puede-borrar: Boton {
                        texto: "Borrar";
                        peligro: true;
                        clicked => {
                            Form.borrar();
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    Boton {
                        texto: "Cancelar";
                        clicked => {
                            Form.cancelar();
                        }
                    }
                    Boton {
                        texto: "Guardar";
                        primario: true;
                        clicked => {
                            Form.guardar();
                        }
                    }
                }
            }
            }
        }
    }
}

// Ajustes de un módulo del tablero; también permite hacer con teclado lo que se hace arrastrando.
export component DialogoModulo inherits Rectangle {
    width: 100%;
    height: 100%;
    property <bool> tiene-opciones: TableroD.editor.con-tam || TableroD.editor.vistas.length > 0;
    function cerrar() {
        TableroD.editor-abierto = false;
        TableroD.aplicar-titulo();
    }
    Fondo-Modal {
        width: parent.width;
        height: parent.height;
    }
    FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.cerrar();
                return accept;
            }
            reject
        }
        Vidrio {
            fuerte: true;
            width: min(520px, root.width - 24px);
            height: min(c.preferred-height, root.height - 24px);
            x: (root.width - self.width) / 2;
            y: max(12px, (root.height - self.height) / 2);
            accessible-role: groupbox;
            accessible-label: "Editar " + TableroD.editor.titulo;
            ScrollView {
                content-width: self.visible-width;
                content-height: c.preferred-height;
            c := VerticalLayout {
                width: parent.visible-width;
                padding: 24px;
                spacing: 14px;
                Titulo {
                    text: TableroD.editor.titulo;
                    font-size: 19px;
                }
                if TableroD.editor.con-titulo: Campos {
                    etiqueta: "Título";
                    Campo {
                        etiqueta: "Título del módulo";
                        texto: TableroD.editor.titulo-propio;
                        marcador: TableroD.editor.titulo;
                        editado(x) => {
                            TableroD.escribir-titulo(TableroD.editor.tipo, x);
                        }
                        aceptado => {
                            root.cerrar();
                        }
                    }
                }
                Campos {
                    etiqueta: "Ancho";
                    Selector {
                        etiqueta: "Ancho del módulo";
                        opciones: ["Un tercio", "La mitad", "Dos tercios", "Completo"];
                        indice: TableroD.editor.ancho-i;
                        cambiado(i) => {
                            TableroD.cambiar-ancho(TableroD.editor.tipo, i);
                        }
                    }
                }
                if TableroD.editor.con-tam: Campos {
                    etiqueta: "Tamaño";
                    Selector {
                        etiqueta: "Tamaño del módulo";
                        opciones: TableroD.editor.tams;
                        indice: TableroD.editor.tam;
                        cambiado(i) => {
                            TableroD.cambiar-tam(TableroD.editor.tipo, i);
                        }
                    }
                }
                if TableroD.editor.vistas.length > 0: Campos {
                    etiqueta: "Vista";
                    Selector {
                        etiqueta: "Vista del módulo";
                        opciones: TableroD.editor.vistas;
                        indice: TableroD.editor.vista;
                        cambiado(i) => {
                            TableroD.cambiar-vista(TableroD.editor.tipo, i);
                        }
                    }
                }
                Campos {
                    etiqueta: "Lugar";
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Boton {
                            texto: "Antes";
                            icono: Iconos.anterior;
                            etiqueta-accesible: "Mover antes";
                            clicked => {
                                TableroD.mover(TableroD.editor.tipo, true);
                            }
                        }
                        Boton {
                            texto: "Después";
                            icono: Iconos.siguiente;
                            etiqueta-accesible: "Mover después";
                            clicked => {
                                TableroD.mover(TableroD.editor.tipo, false);
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Boton {
                        texto: "Quitar";
                        peligro: true;
                        clicked => {
                            TableroD.ocultar(TableroD.editor.tipo, false);
                            root.cerrar();
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    Boton {
                        texto: "Listo";
                        primario: true;
                        init => {
                            self.focus();
                        }
                        clicked => {
                            root.cerrar();
                        }
                    }
                }
            }
            }
        }
    }
}

export component DialogoAnadir inherits Rectangle {
    width: 100%;
    height: 100%;
    Fondo-Modal {
        width: parent.width;
        height: parent.height;
    }
    FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                TableroD.anadir-abierto = false;
                return accept;
            }
            reject
        }
        Vidrio {
            fuerte: true;
            width: min(480px, root.width - 40px);
            height: min(c.preferred-height, root.height - 40px);
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            accessible-role: groupbox;
            accessible-label: "Añadir módulo";
            c := VerticalLayout {
                padding: 24px;
                spacing: 10px;
                Titulo {
                    text: "Añadir módulo";
                    font-size: 19px;
                }
                if TableroD.ocultos.length == 0: Ayuda {
                    text: "Ya están todos en el tablero. Pulsa − en un módulo para quitarlo.";
                }
                for o in TableroD.ocultos: HorizontalLayout {
                    alignment: start;
                    Boton {
                        texto: o.titulo;
                        icono: Iconos.mas;
                        etiqueta-accesible: "Añadir " + o.titulo;
                        clicked => {
                            TableroD.ocultar(o.tipo, true);
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    Boton {
                        texto: "Cerrar";
                        init => {
                            self.focus();
                        }
                        clicked => {
                            TableroD.anadir-abierto = false;
                        }
                    }
                }
            }
        }
    }
}

export component DialogoAlertas inherits Rectangle {
    width: 100%;
    height: 100%;
    Fondo-Modal {
        width: parent.width;
        height: parent.height;
    }
    FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                App.alertas-abiertas = false;
                return accept;
            }
            reject
        }
        Vidrio {
            fuerte: true;
            width: min(720px, root.width - 40px);
            height: min(c.preferred-height, root.height - 40px);
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            accessible-role: groupbox;
            accessible-label: "Pagos cercanos";
            c := VerticalLayout {
                padding: 24px;
                spacing: 14px;
                Titulo {
                    text: "Pagos cercanos";
                    font-size: 19px;
                }
                if App.alertas.length == 0: Ayuda {
                    text: "No tienes pagos vencidos ni próximos.";
                }
                if App.alertas.length > 0: ScrollView {
                    vertical-stretch: 1;
                    preferred-height: lista.preferred-height;
                    content-height: lista.preferred-height;
                    content-width: self.visible-width;
                    lista := VerticalLayout {
                        width: parent.visible-width;
                        for g[i] in App.alertas: VerticalLayout {
                            if i > 0: Separador { }
                            HorizontalLayout {
                                padding-top: 10px;
                                padding-bottom: 10px;
                                padding-right: 12px;
                                spacing: 10px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 3px;
                                    alignment: center;
                                    Text {
                                        text: g.titulo + " · " + g.periodo;
                                        color: Tema.texto;
                                        overflow: elide;
                                    }
                                    Rectangle {
                                        height: 20px;
                                        clip: true;
                                    HorizontalLayout {
                                        x: 0;
                                        width: self.preferred-width;
                                        spacing: 6px;
                                        alignment: start;
                                        // Solo el vencimiento y la fecha: el resto no cabe en el diálogo.
                                        for e[j] in g.etiquetas: Chip {
                                            visible: j < 2;
                                            width: j < 2 ? self.preferred-width : 0px;
                                            texto: e;
                                        }
                                    }
                                    }
                                    Text {
                                        text: g.monto;
                                        color: Tema.texto;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Boton {
                                        texto: "Marcar pagado";
                                        solo-icono: root.width < 620px;
                                        icono: Iconos.check;
                                        clicked => {
                                            ResumenD.marcar-pagado(g.id);
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Boton {
                                        texto: "Editar";
                                        solo-icono: root.width < 620px;
                                        icono: Iconos.lapiz;
                                        clicked => {
                                            App.alertas-abiertas = false;
                                            App.abrir-gasto(g.id);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    Boton {
                        texto: "Cerrar";
                        init => {
                            self.focus();
                        }
                        clicked => {
                            App.alertas-abiertas = false;
                        }
                    }
                }
            }
        }
    }
}

export component DialogoConfirmar inherits Rectangle {
    width: 100%;
    height: 100%;
    Fondo-Modal {
        width: parent.width;
        height: parent.height;
    }
    FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                Confirmar.no();
                return accept;
            }
            reject
        }
        Vidrio {
            fuerte: true;
            width: min(480px, root.width - 40px);
            height: c.preferred-height;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            accessible-role: groupbox;
            accessible-label: Confirmar.titulo;
            c := VerticalLayout {
                padding: 24px;
                spacing: 14px;
                Titulo {
                    text: Confirmar.titulo;
                    font-size: 19px;
                    wrap: word-wrap;
                }
                Text {
                    text: Confirmar.texto;
                    color: Tema.texto;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Boton {
                        texto: "Cancelar";
                        init => {
                            self.focus();
                        }
                        clicked => {
                            Confirmar.no();
                        }
                    }
                    Boton {
                        texto: Confirmar.boton;
                        primario: true;
                        clicked => {
                            Confirmar.si();
                        }
                    }
                }
            }
        }
    }
}
